{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "types": ["node"],
        "paths": {
            "h3": ["./node_modules/h3"],
            "~/composables/auth/useSessionContext": ["./src/shims/use-session-context.d.ts"],
            "~/composables/auth/confirmClientSignedOut": ["./src/shims/confirm-client-signed-out.d.ts"],
            "~/composables/auth/useClientSessionRecovery": ["./src/shims/use-client-session-recovery.d.ts"],
            "#imports": ["./src/shims/imports.ts"]
        }
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "dist", "src/**/__tests__/**"]
}
