{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noImplicitAny": false,
    "paths": {
      "h3": ["./node_modules/h3"],
      "~~/*": ["./src/shims/or3-chat-contract.ts"],
      "~~": ["./src/shims/or3-chat-contract.ts"],
      "~/*": ["./src/shims/or3-chat-contract.ts"],
      "~": ["./src/shims/or3-chat-contract.ts"],
      "#imports": ["./src/shims/imports.ts"],
      "#app": ["./src/shims/host-app.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "src/**/__tests__/**"]
}
